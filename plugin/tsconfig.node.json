{
	// Node-side files (scripts, *.spec.ts): run by plain `node`, so they get Node types. Hooks stay sandbox-only (tsconfig.json).
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"allowImportingTsExtensions": true,
		"composite": true,
		"emitDeclarationOnly": true,
		"outDir": "../node_modules/.cache/tsc-plugin-node",
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["scripts", "tests/*.spec.ts", "hooks/calibration.ts", "hooks/playbook.ts", "hooks/signals.ts", "hooks/yaml.ts"]
}
